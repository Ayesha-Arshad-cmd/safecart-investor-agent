# ─────────────────────────────────────────────────────────────
# Railway: put these in your service → Variables.
# Your computer: copy this file to a new file named .env and fill it in.
# NEVER commit real keys to GitHub.
# ─────────────────────────────────────────────────────────────

# Protects your app (and your free AI quota) with a password. Strongly recommended.
APP_PASSWORD=choose-a-long-password

# ── AI (add at least ONE; more = automatic fallback when a free limit is hit) ──
# Google AI Studio — free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq — free, no card: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter free models — free, no card: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Hugging Face (tiny free monthly credit): https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional model overrides (normally auto-detected)
# GEMINI_MODEL=
# GROQ_MODEL=

# ── Search (finds investor websites + public LinkedIn profiles) ──
# Tavily — 1,000 free searches/month, no card: https://app.tavily.com
TAVILY_API_KEY=
# Serper (Google results) — 2,500 free searches, no card: https://serper.dev
SERPER_API_KEY=
# DuckDuckGo is used automatically as a no-key fallback.

# ── Automatic email from YOUR Gmail ($0) — see README "Automatic email" ──
# The Web app URL of google-apps-script/Code.gs (ends with /exec)
GMAIL_SCRIPT_URL=
# The same SECRET you typed at the top of Code.gs
GMAIL_SCRIPT_SECRET=
# Optional tuning (defaults are fine)
# AUTOMATION_TICK_MS=300000      # how often the server checks for emails to send (5 min)
# AUTOMATION_CHECK_MS=900000     # how often it reads your inbox for replies (15 min)
# AGENT_PACE_MS=8000             # pause between AI steps in big runs (protects free limits)

# ── Optional backup sender: Brevo (used only if the Gmail helper isn't set) ──
# Brevo free plan, no card: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=

# ── Storage ──
# On Railway: mount a Volume at /data and set DATA_DIR=/data there.
# On Render: do NOT set DATA_DIR. Set DRIVE_BACKUP=1 instead (your lists are kept in your Google Drive).
# On your own computer: leave both commented out (data goes to the ./data folder).
# DATA_DIR=/data
# DRIVE_BACKUP=1
# DRIVE_BACKUP_EVERY_MS=600000   # how often (at most) the Drive backup is sent; default 10 minutes
